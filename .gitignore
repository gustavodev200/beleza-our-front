# Dependencies
node_modules/
.pnp
.pnp.*

# Next.js / build output
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# Environment / secrets
# Glob instead of literals: a stray .env.bak / .env.prod / .env.local is exactly
# how a secrets file reaches a public repo. Only placeholders are versioned.
.env*
!.env.example
!templates/**/.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
secrets/

# Tests / coverage
coverage/
test-results/
playwright-report/
playwright/.cache/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vercel
.vercel

# OS
.DS_Store
Thumbs.db

# IDE / local agent settings
.vscode/
.idea/
.claude/settings.local.json
