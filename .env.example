# Copie para .env.local. Nunca commite arquivos .env com valores reais.

# URL interna da API NestJS (sem /api). Usada pelo rewrite /api/* e pelo SSR.
# Nunca exposta ao navegador: o navegador sempre chama /api na mesma origem.
API_URL=http://localhost:3333

# Origem pública deste app (links compartilháveis, metadata, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
